{"author": "binder-manager", "approver": "delegated-authority-lead", "binder_id": "binder_C", "effective_from": "2026-10-15", "effective_to": null, "notes": ["C-004 frame-plus-no-hardwired-alarm is a per-site AND logic_group, mirroring B-003: it bites only when one site is both frame and not hardwired.", "C-008 uses derived location_count (len of locations); derivation added to derive.py.", "Fresh-produce codes are a business placeholder until the commodity code list is published."], "rules": [{"binder_id": "binder_C", "business_description": "If the insured is located in California", "category": "Insured Address", "field_reference": "insured_state_province", "operator": "neq", "rule_id": "C-001-CALIFORNIA", "scope": "submission", "severity": "refer", "threshold_unit": "code", "threshold_value": "CA"}, {"binder_id": "binder_C", "business_description": "If the insured has two or more losses in the last 5 years", "category": "Loss History", "field_reference": "claim_count_5_years", "operator": "lt", "rule_id": "C-002-LOSSES-5Y", "scope": "submission", "severity": "refer", "threshold_unit": "count", "threshold_value": 2}, {"binder_id": "binder_C", "business_description": "If any scheduled location is outside the United States", "category": "Location Geography", "field_reference": "locations.country", "operator": "in", "rule_id": "C-003-US-ONLY", "scope": "location", "severity": "refer", "threshold_unit": "code", "threshold_value": ["US"]}, {"binder_id": "binder_C", "business_description": "Frame construction without hardwired alarm: frame element", "category": "Construction / COPE", "field_reference": "locations.construction_type", "logic": "AND", "logic_group": "C-004-FRAME-ALARM", "operator": "neq", "rule_id": "C-004a-FRAME", "scope": "location", "severity": "refer", "threshold_unit": "code", "threshold_value": "FRAME"}, {"binder_id": "binder_C", "business_description": "Frame construction without hardwired alarm: alarm element", "category": "Construction / COPE", "field_reference": "locations.alarm_type", "logic": "AND", "logic_group": "C-004-FRAME-ALARM", "operator": "eq", "rule_id": "C-004b-HARDWIRED", "scope": "location", "severity": "refer", "threshold_unit": "code", "threshold_value": "HARDWIRED"}, {"binder_id": "binder_C", "business_description": "If the valuation method is not clearly stated", "category": "Valuation Method", "field_reference": "valuation_basis_stated_clearly", "operator": "is_true", "rule_id": "C-005-VALUATION-CLEAR", "scope": "submission", "severity": "refer", "threshold_unit": "boolean", "threshold_value": true}, {"binder_id": "binder_C", "business_description": "If the policy term is not exactly 12 months", "category": "Coverage Type / Term", "field_reference": "policy_term_months", "operator": "eq", "rule_id": "C-006-TERM-12M", "scope": "submission", "severity": "refer", "threshold_unit": "months", "threshold_value": 12}, {"binder_id": "binder_C", "business_description": "If the insured requests profit sharing", "category": "Submission Quality", "field_reference": "profit_share_requested", "operator": "is_false", "rule_id": "C-007-PROFIT-SHARE", "scope": "submission", "severity": "refer", "threshold_unit": "boolean", "threshold_value": false}, {"binder_id": "binder_C", "business_description": "If more than 3 warehouse locations are listed", "category": "Location Count / Setup", "field_reference": "location_count", "operator": "lte", "rule_id": "C-008-LOCATION-COUNT", "scope": "submission", "severity": "refer", "threshold_unit": "count", "threshold_value": 3}, {"binder_id": "binder_C", "business_description": "If the commodity includes Fresh Produce (e.g., fruits or vegetables)", "category": "Commodity Rule", "field_reference": "commodities.commodity_type", "operator": "not_in", "rule_id": "C-009-FRESH-PRODUCE", "scope": "submission", "severity": "refer", "threshold_unit": "code", "threshold_value": ["FRESH_PRODUCE", "FRESH PRODUCE", "FRUIT", "VEGETABLES"]}], "version": 1}